# Server-only BFF provider and mutation-policy settings. Keep values in
# platform settings and never expose them through NEXT_PUBLIC_* names.
SUPABASE_URL=
SUPABASE_ANON_KEY=
ALLOWED_ORIGINS=
# Local development only; production always forces Secure cookies.
ALLOW_INSECURE_LOCAL_COOKIES=false
# Optional server-only API origin for future typed calls.
# API_ORIGIN=
# NEXT_PUBLIC_APP_ENV=
