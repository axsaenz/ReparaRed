{
  "name": "reparared",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:web": "npm run build --workspace=@repara/web",
    "build:api": "npm run build --workspace=@repara/api",
    "ci:check": "npm ci"
  }
}
