{
  "name": "reparared",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@12.0.1",
  "scripts": {
    "lint": "npm run lint --workspace=@repara/web --workspace=@repara/api",
    "lint:web": "eslint --config eslint.config.mjs apps/web packages/config",
    "lint:api": "eslint --config eslint.config.mjs apps/api",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspace=@repara/web --workspace=@repara/api --workspace=@repara/api-client",
    "test": "npm run test --workspace=@repara/web --workspace=@repara/api",
    "build": "npm run build --workspace=@repara/web --workspace=@repara/api --workspace=@repara/api-client",
    "build:web": "npm run build --workspace=@repara/web",
    "build:api": "npm run build --workspace=@repara/api",
    "contract:export": "node scripts/contract.mjs export",
    "contract:generate": "node scripts/contract.mjs generate",
    "contract:validate": "node scripts/contract.mjs validate",
    "contract:check": "node scripts/contract.mjs check",
    "contract:diff": "node scripts/contract.mjs diff",
    "ci:check": "npm ci"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "12.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "openapi-diff": "0.24.1",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  }
}
